# ── OrbitalWatch Backend Environment Example ─────────────────────────────────
# Copy to .env and fill in your values.
# IMPORTANT: No inline comments — dotenv parses them as part of the value!

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev (default): SQLite
DATABASE_URL=sqlite+aiosqlite:///./orbitalwatch.db
# Production (Render/PostgreSQL): uncomment and fill in your Render Postgres URL
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# ── Redis ─────────────────────────────────────────────────────────────────────
# Optional. Leave as-is for local dev without Redis.
REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list or JSON array of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── Server ────────────────────────────────────────────────────────────────────
# RELOAD: set to true for local dev hot-reload; MUST be false in production
RELOAD=false
WEB_CONCURRENCY=1
PYTHON_VERSION=3.10.0

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" on Render to disable synthetic conjunction seeding
ENVIRONMENT=development
