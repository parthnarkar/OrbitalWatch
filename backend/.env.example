# Default to SQLite for seamless local development without Docker
# For Render production, simply attach a Render Postgres DB and it will override this automatically
DATABASE_URL=sqlite+aiosqlite:///./orbitalwatch.db
REDIS_URL=redis://localhost:6379/0
# Production Server settings
# Number of Gunicorn workers (default 1 for 512MB RAM, set higher if more RAM is available)
WEB_CONCURRENCY=1

# CORS configuration (Crucial for Vercel <-> Render communication)
# Local development: ["http://localhost:5173", "http://127.0.0.1:5173"]
# Production on Render: ["https://your-frontend-app.vercel.app"]
CORS_ORIGINS=["http://localhost:5173"]
RELOAD=true